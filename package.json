{
	"name": "openagentix-site",
	"private": true,
	"version": "0.1.0",
	"type": "module",
	"license": "Apache-2.0",
	"packageManager": "pnpm@11.13.1",
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build && node scripts/og-image.mjs && node scripts/postbuild.mjs",
		"preview": "node scripts/serve.mjs",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test": "vitest run",
		"test:content": "node scripts/check-content.mjs build",
		"test:links": "node scripts/check-links.mjs build",
		"test:e2e": "playwright test",
		"test:all": "pnpm lint && pnpm check && pnpm test && pnpm build && pnpm test:content && pnpm test:links && pnpm test:e2e"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.14.0",
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.65.1",
		"@sveltejs/adapter-static": "^4.0.1",
		"@sveltejs/kit": "^3.4.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.2",
		"@tailwindcss/vite": "^4.3.5",
		"@types/node": "^26.6.6",
		"eslint": "^10.15.0",
		"eslint-plugin-svelte": "^3.24.1",
		"globals": "^17.14.0",
		"prettier": "^3.10.1",
		"prettier-plugin-svelte": "^4.2.0",
		"svelte": "^5.59.1",
		"svelte-check": "^4.7.8",
		"tailwindcss": "^4.3.5",
		"typescript": "^7.0.2",
		"typescript-eslint": "^8.74.0",
		"vite": "^8.3.8",
		"vitest": "^5.1.1"
	},
	"imports": {
		"#lib/*": "./src/lib/*"
	}
}
