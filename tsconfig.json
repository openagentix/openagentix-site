{
	"extends": "$app/tsconfig",
	"include": ["src", "tests", "*"],
	"exclude": ["src/service-worker"],
	"compilerOptions": {
		"allowJs": true,
		"checkJs": false,
		"strict": true,
		"noUncheckedIndexedAccess": true,
		"skipLibCheck": true,
		"paths": { "#lib/*": ["./src/lib/*"] },
		"resolveJsonModule": true
	}
}
